{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": true,
        ".write": false,
        "teams": {
          ".write": true
        },
        "reveals": {
          ".write": true
        },
        "settings": {
          ".write": true
        },
        "status": {
          ".write": true,
          ".validate": "newData.val() === 'waiting' || newData.val() === 'live' || newData.val() === 'done'"
        },
        "viewers": {
          ".read": true,
          ".write": true
        },
        "hostId": {
          ".write": false
        },
        "createdAt": {
          ".write": false
        },
        "expiresAt": {
          ".write": false
        },
        "players": {
          ".write": false
        },
        "currentReveal": {
          ".write": true
        }
      }
    }
  }
}
